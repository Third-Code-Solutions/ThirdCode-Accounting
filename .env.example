# Standalone TCSI platform configuration. Never commit real values.
NODE_ENV=development
NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hosted portal safety boundary. Standalone workflows remain unreleased.
TCSI_PORTAL_ONLY=true
TCSI_PILOT_URL=

# Railway worker values. Keep the service-role key server-side only.
WORKER_PORT=3001
WORKER_ENV=development
WORKER_POLL_INTERVAL_MS=60000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Legacy local verification values are intentionally separate from the new runtime.
ODOO_DB=thirdcode_accounting
ODOO_PORT=8069
