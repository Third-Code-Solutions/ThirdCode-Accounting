# Copy this file once per company. Never reuse project names, ports, or secrets.
# Start one installation with:
# docker compose --env-file /private/company.env -f docker-compose.independent.yml up -d
# First boot installs the accounting modules and can remain "starting" for more
# than ten minutes on slow storage. Wait for the Odoo service to become healthy.
COMPOSE_PROJECT_NAME=company-accounting
ODOO_PORT=18069

# Release handoff: use registry.example/thirdcode-accounting@sha256:<digest>.
# A local rehearsal may use sha256:<local-image-id>. Mutable tags are dev-only.
TCSI_ODOO_IMAGE=

# PostgreSQL bootstrap administrator. Odoo never receives these credentials.
# PostgreSQL reads this password only when creating an empty database volume;
# later rotation requires ALTER ROLE plus the matching environment update.
PG_ADMIN_USER=company_db_admin
PG_ADMIN_PASSWORD=

# Least-privilege application role and its single database. db-init reconciles
# this password at each start, so changing it here rotates the application role.
PGUSER=company_odoo
PGPASSWORD=
PGDATABASE=company_accounting

# Initial Odoo administrator and database-manager credentials. Compose refuses
# to start until these are set; never copy credentials from another installation.
TCSI_ADMIN_LOGIN=
TCSI_ADMIN_PASSWORD=
TCSI_MASTER_PASSWORD=

# Optional resource tuning.
TCSI_WORKERS=2
TCSI_DB_MAXCONN=8
TCSI_LIMIT_TIME_REAL=600
