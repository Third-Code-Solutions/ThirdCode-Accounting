<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_period_company" model="ir.rule">
            <field name="name">Accounting periods: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_accounting_period"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_recurring_journal_company" model="ir.rule">
            <field name="name">Recurring journals: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_recurring_journal"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_recurring_journal_line_company" model="ir.rule">
            <field name="name">Recurring journal lines: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_recurring_journal_line"/>
            <field name="domain_force">[('recurring_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_recurring_invoice_company" model="ir.rule">
            <field name="name">Recurring invoices: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_recurring_invoice"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_recurring_invoice_line_company" model="ir.rule">
            <field name="name">Recurring invoice lines: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_recurring_invoice_line"/>
            <field name="domain_force">[('recurring_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_payment_batch_company" model="ir.rule">
            <field name="name">Payment batches: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_payment_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_payment_batch_line_company" model="ir.rule">
            <field name="name">Payment batch lines: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_payment_batch_line"/>
            <field name="domain_force">[('batch_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_migration_batch_company" model="ir.rule">
            <field name="name">Migration batches: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_migration_batch"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_migration_row_company" model="ir.rule">
            <field name="name">Migration rows: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_migration_row"/>
            <field name="domain_force">[('batch_id.company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_sample_company" model="ir.rule">
            <field name="name">Report samples: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_report_sample"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_tax_profile_company" model="ir.rule">
            <field name="name">Tax profiles: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_tax_profile"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_bank_reconciliation_company" model="ir.rule">
            <field name="name">Bank reconciliations: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_bank_reconciliation"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_year_end_close_company" model="ir.rule">
            <field name="name">Year-end closes: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_year_end_close"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_orvexa_proposal_company" model="ir.rule">
            <field name="name">ORVEXA proposals: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_orvexa_proposal"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_orvexa_event_company" model="ir.rule">
            <field name="name">ORVEXA activity: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_orvexa_event"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- res.users delegates contact fields; all internal identities need the
             same tenant boundary, regardless of optional business-role groups. -->
        <record id="rule_thirdcode_res_users_company" model="ir.rule">
            <field name="name">Users: within own companies (TCSI tenants)</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="groups" eval="[Command.clear()]"/>
            <field name="global" eval="True"/>
            <field name="domain_force">[] if user._thirdcode_is_contact_owner() else ['|', ('id', '=', user.id), '&amp;', ('company_ids', 'in', company_ids), ('thirdcode_platform_owner', '=', False)]</field>
        </record>
        <record id="rule_audit_log_company" model="ir.rule">
            <field name="name">Audit evidence: recorded company scope</field>
            <field name="model_id" ref="auditlog.model_auditlog_log"/>
            <field name="domain_force">[] if user.has_group('base.group_system') else [('thirdcode_company_ids', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_audit_log_line_company" model="ir.rule">
            <field name="name">Audit field evidence: recorded company scope</field>
            <field name="model_id" ref="auditlog.model_auditlog_log_line"/>
            <field name="domain_force">[] if user.has_group('base.group_system') else [('log_id.thirdcode_company_ids', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_cash_allocation_company" model="ir.rule"><field name="name">Cash flow allocation company scope</field><field name="model_id" ref="model_thirdcode_cash_flow_allocation"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
        <record id="rule_tax_summary_company" model="ir.rule"><field name="name">Tax summary company scope</field><field name="model_id" ref="model_thirdcode_tax_summary_wizard"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
        <record id="rule_migration_archive_company" model="ir.rule"><field name="name">Source history company scope</field><field name="model_id" ref="model_thirdcode_migration_archive_entry"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="global" eval="True"/></record>
        <record id="rule_contact_modify_scope" model="ir.rule">
            <field name="name">Contacts: shared access does not grant editing</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">user._thirdcode_contact_domain(company_ids, write=True)</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_contact_bank_modify_scope" model="ir.rule">
            <field name="name">Contact banks: company-owned modifications</field>
            <field name="model_id" ref="base.model_res_partner_bank"/>
            <field name="domain_force">user._thirdcode_contact_domain(company_ids, write=True, bank=True)</field>
            <field name="perm_read" eval="False"/>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
