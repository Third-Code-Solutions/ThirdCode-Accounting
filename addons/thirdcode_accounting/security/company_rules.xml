<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="rule_period_company" model="ir.rule">
            <field name="name">Accounting periods: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_accounting_period"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_recurring_journal_company" model="ir.rule">
            <field name="name">Recurring journals: allowed companies</field>
            <field name="model_id" ref="model_thirdcode_recurring_journal"/>
