<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Business roles are mapped to native Odoo capabilities. Auditlog
             access is read-only here; the model override below prevents
             application users from editing or purging retained entries. -->
        <record id="group_thirdcode_readonly" model="res.groups">
            <field name="name">TCSI Read-only</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly')), (4, ref('auditlog.group_auditlog_user'))]"/>
        </record>

        <record id="group_thirdcode_encoder" model="res.groups">
            <field name="name">TCSI Encoder</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('auditlog.group_auditlog_user'))]"/>
        </record>

        <record id="group_thirdcode_accountant" model="res.groups">
            <field name="name">TCSI Accountant</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user')), (4, ref('base.group_partner_manager')), (4, ref('hr_expense.group_hr_expense_team_approver')), (4, ref('auditlog.group_auditlog_user'))]"/>
        </record>

        <record id="group_thirdcode_administrator" model="res.groups">
            <field name="name">TCSI Accounting Administrator</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager')), (4, ref('base.group_partner_manager')), (4, ref('hr_expense.group_hr_expense_manager')), (4, ref('auditlog.group_auditlog_user'))]"/>
        </record>
    </data>
</odoo>
