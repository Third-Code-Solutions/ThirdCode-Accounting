<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Business roles are mapped to native Odoo capabilities. Tenant audit
             access is deliberately scoped: the native auditlog group also
             exposes HTTP session records (raw session identifiers) and request
             metadata, so roles imply a TCSI reader instead, and only the
             retained log and field-history models stay readable. -->
        <record id="group_thirdcode_audit_reader" model="res.groups">
            <field name="name">TCSI Audit Evidence Reader</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="group_thirdcode_readonly" model="res.groups">
            <field name="name">TCSI Read-only</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_readonly')), (4, ref('group_thirdcode_audit_reader'))]"/>
        </record>

        <record id="group_thirdcode_encoder" model="res.groups">
            <field name="name">TCSI Encoder</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('group_thirdcode_audit_reader'))]"/>
        </record>

        <record id="group_thirdcode_accountant" model="res.groups">
            <field name="name">TCSI Accountant</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_user')), (4, ref('base.group_partner_manager')), (4, ref('hr_expense.group_hr_expense_team_approver')), (4, ref('group_thirdcode_audit_reader'))]"/>
        </record>

        <record id="group_thirdcode_administrator" model="res.groups">
            <field name="name">TCSI Accounting Administrator</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('account.group_account_manager')), (4, ref('base.group_partner_manager')), (4, ref('account.group_validate_bank_account')), (4, ref('hr_expense.group_hr_expense_manager')), (4, ref('group_thirdcode_audit_reader'))]"/>
        </record>

        <!-- Platform-owner console access. Granted only through provisioning of
             platform-owner accounts (base.group_system holders); never to tenants. -->
        <record id="group_thirdcode_platform_console" model="res.groups">
            <field name="name">TCSI Platform Console</field>
            <field name="implied_ids" eval="[Command.link(ref('base.group_partner_manager'))]"/>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>
    </data>
</odoo>
