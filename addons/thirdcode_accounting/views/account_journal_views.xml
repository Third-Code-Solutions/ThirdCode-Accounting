<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form_thirdcode_controls" model="ir.ui.view">
        <field name="name">account.journal.form.thirdcode.controls</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Third Code Controls" groups="thirdcode_accounting.group_thirdcode_accountant,thirdcode_accounting.group_thirdcode_administrator">
                    <div class="tcsi-form-sections">
                        <group string="Numbering control" class="tcsi-form-section">
                            <field name="thirdcode_numbering_policy" string="Numbering policy"/>
                            <field name="thirdcode_numbering_owner" string="Numbering owner"/>
                            <field name="thirdcode_numbering_checked_at" string="Last validated" readonly="1"/>
                            <field name="has_sequence_holes" string="Sequence gaps" readonly="1"/>
                        </group>
                        <group string="Review notes" class="tcsi-form-section">
                            <field name="thirdcode_numbering_notes" string="Numbering notes" nolabel="1" colspan="2"/>
                        </group>
                    </div>
                    <button name="action_validate_thirdcode_numbering" type="object" string="Validate observed numbering" class="oe_highlight"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
