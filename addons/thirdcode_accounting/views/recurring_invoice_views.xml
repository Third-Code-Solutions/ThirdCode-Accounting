<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thirdcode_recurring_invoice_list" model="ir.ui.view">
        <field name="name">thirdcode.recurring.invoice.list</field>
        <field name="model">thirdcode.recurring.invoice</field>
        <field name="arch" type="xml">
            <list string="Recurring invoices and bills">
                <field name="name"/>
                <field name="reference"/>
                <field name="move_type"/>
                <field name="partner_id"/>
                <field name="journal_id"/>
                <field name="next_run"/>
                <field name="interval_number"/>
                <field name="interval_type"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_thirdcode_recurring_invoice_form" model="ir.ui.view">
        <field name="name">thirdcode.recurring.invoice.form</field>
        <field name="model">thirdcode.recurring.invoice</field>
        <field name="arch" type="xml">
            <form string="Recurring invoice or supplier bill">
                <header>
                    <button name="action_run_now" type="object" string="Run now" class="oe_highlight" groups="thirdcode_accounting.group_thirdcode_accountant,thirdcode_accounting.group_thirdcode_administrator"/>
                    <button name="action_run_due" type="object" string="Run due periods" groups="thirdcode_accounting.group_thirdcode_accountant,thirdcode_accounting.group_thirdcode_administrator"/>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <group col="2" class="tcsi-form-sections">
                        <group string="Document details" class="tcsi-form-section">
                            <field name="name"/>
                            <field name="reference"/>
                            <field name="move_type"/>
                            <field name="company_id"/>
                            <field name="partner_id"/>
                            <field name="journal_id"/>
                            <field name="payment_term_id"/>
                        </group>
                        <group string="Schedule" class="tcsi-form-section">
                            <field name="date_start"/>
                            <field name="next_run"/>
                            <field name="interval_number"/>
                            <field name="interval_type"/>
                            <field name="last_run" readonly="1"/>
                            <field name="narration"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Invoice lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                </list>
                            </field>
                        </page>
                        <page string="Generated documents">
                            <field name="generated_move_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="move_type"/>
                                    <field name="invoice_date"/>
                                    <field name="state"/>
                                    <field name="amount_total"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_thirdcode_recurring_invoice" model="ir.actions.act_window">
        <field name="name">Recurring invoices and bills</field>
        <field name="res_model">thirdcode.recurring.invoice</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
