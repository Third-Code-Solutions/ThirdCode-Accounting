<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thirdcode_migration_batch_tree" model="ir.ui.view"><field name="name">thirdcode.migration.batch.tree</field><field name="model">thirdcode.migration.batch</field><field name="arch" type="xml"><list string="Migration batches"><field name="name"/><field name="source_system"/><field name="cutover_date"/><field name="state" widget="badge"/><field name="row_count"/><field name="matched_count"/><field name="error_count"/><field name="owner_id"/></list></field></record>
    <record id="view_thirdcode_migration_batch_form" model="ir.ui.view">
        <field name="name">thirdcode.migration.batch.form</field><field name="model">thirdcode.migration.batch</field>
        <field name="arch" type="xml">
            <form string="Migration batch">
                <header><button name="action_validate" type="object" string="Validate" class="oe_highlight" invisible="state != 'draft'"/><button name="action_mark_loaded" type="object" string="Mark loaded" invisible="state != 'validated'"/><button name="action_mark_reconciled" type="object" string="Sign off reconciliation" class="oe_highlight" invisible="state != 'loaded'"/><field name="state" widget="statusbar" statusbar_visible="draft,validated,loaded,reconciled"/></header>
                <sheet>
                    <group col="2" class="tcsi-form-sections">
                        <group string="Migration details" class="tcsi-form-section">
                            <field name="name" readonly="1"/>
                            <field name="source_system"/>
                            <field name="company_id"/>
                            <field name="cutover_date"/>
                            <field name="retention_policy"/>
                            <field name="source_file_hash"/>
                            <field name="owner_id"/>
                            <field name="opening_balance_owner"/>
                        </group>
                        <group string="Validation totals" class="tcsi-form-section">
                            <field name="row_count" readonly="1"/>
                            <field name="matched_count" readonly="1"/>
                            <field name="error_count" readonly="1"/>
                        </group>
                    </group>
                    <field name="row_ids"><list editable="bottom"><field name="source_identifier"/><field name="target_model"/><field name="target_id"/><field name="source_debit"/><field name="source_credit"/><field name="target_debit"/><field name="target_credit"/><field name="state" widget="badge"/><field name="error_message"/></list></field>
                    <field name="notes"/><chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_thirdcode_migration_batch" model="ir.actions.act_window"><field name="name">Migration batches</field><field name="res_model">thirdcode.migration.batch</field><field name="view_mode">list,form</field></record>
</odoo>
