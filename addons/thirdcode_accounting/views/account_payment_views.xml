<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_form_thirdcode" model="ir.ui.view">
        <field name="name">account.payment.form.thirdcode.accounting</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_thirdcode_receipt" type="object" string="Official Receipt" class="btn-secondary" invisible="state not in ('in_process', 'paid')" groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="thirdcode_payment_instrument" string="Payment instrument"/>
                <field name="thirdcode_instrument_reference" string="Instrument reference"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <div class="tcsi-form-sections">
                    <group string="Receipt details" class="tcsi-form-section">
                        <field name="thirdcode_receipt_number" string="Receipt number" readonly="1"/>
                        <field name="thirdcode_receipt_control_number" string="BIR control number" readonly="1"/>
                        <field name="thirdcode_receipt_customer_tin" string="Customer TIN" readonly="1"/>
                        <field name="thirdcode_report_status" string="Layout status" readonly="1"/>
                    </group>
                    <group string="Amount and tax" class="tcsi-form-section">
                        <field name="thirdcode_amount_in_words" string="Amount in words" readonly="1"/>
                        <field name="thirdcode_receipt_vat_amount" string="Invoice VAT amount" readonly="1"/>
                        <field name="thirdcode_receipt_vat_breakdown" string="Invoice VAT breakdown" readonly="1"/>
                    </group>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
