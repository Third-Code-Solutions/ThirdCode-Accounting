<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thirdcode_accounting_period_tree" model="ir.ui.view">
        <field name="name">thirdcode.accounting.period.tree</field>
        <field name="model">thirdcode.accounting.period</field>
        <field name="arch" type="xml">
            <list string="Accounting periods">
                <field name="name"/><field name="company_id"/><field name="date_start"/><field name="date_end"/><field name="state" widget="badge"/><field name="closed_by"/><field name="closed_at"/>
            </list>
        </field>
    </record>
    <record id="view_thirdcode_accounting_period_form" model="ir.ui.view">
        <field name="name">thirdcode.accounting.period.form</field>
        <field name="model">thirdcode.accounting.period</field>
        <field name="arch" type="xml">
            <form string="Accounting period">
                <header>
                    <button name="action_close" type="object" string="Close" class="oe_highlight" invisible="state == 'closed'" groups="thirdcode_accounting.group_thirdcode_administrator"/>
                    <button name="action_reopen" type="object" string="Reopen" invisible="state != 'closed'" groups="thirdcode_accounting.group_thirdcode_administrator"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,closed"/>
                </header>
                <sheet>
                    <group col="2" class="tcsi-form-sections">
                        <group string="Period details" class="tcsi-form-section">
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Closure evidence" class="tcsi-form-section">
                            <field name="closed_by"/>
                            <field name="closed_at"/>
                            <field name="reopened_by"/>
                            <field name="reopened_at"/>
                            <field name="close_note"/>
                        </group>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_thirdcode_accounting_period" model="ir.actions.act_window">
        <field name="name">Accounting periods</field><field name="res_model">thirdcode.accounting.period</field><field name="view_mode">list,form</field>
    </record>
</odoo>
