    <function model="ir.actions.act_window" name="flush_model"><value eval="['path']"/></function>
    <record id="action_tcsi_apps" model="ir.actions.client"><field name="name">Workspace apps</field><field name="tag">tcsi_apps</field><field name="path">apps</field></record>
