        <field name="name">TCSI invoice list without synthetic records</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml"><xpath expr="//list" position="attributes"><attribute name="sample">0</attribute></xpath></field>
    </record>
