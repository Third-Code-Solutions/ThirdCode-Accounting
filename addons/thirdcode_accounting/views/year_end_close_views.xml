<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thirdcode_year_end_close_list" model="ir.ui.view">
        <field name="name">thirdcode.year.end.close.list</field>
        <field name="model">thirdcode.year.end.close</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_end"/>
                <field name="journal_id"/>
                <field name="retained_earnings_account_id"/>
                <field name="profit_loss"/>
                <field name="state"/>
                <field name="move_id"/>
            </list>
        </field>
    </record>
    <record id="view_thirdcode_year_end_close_form" model="ir.ui.view">
        <field name="name">thirdcode.year.end.close.form</field>
        <field name="model">thirdcode.year.end.close</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_prepare" type="object" string="Prepare" invisible="state != 'draft'"/>
                    <button name="action_post" type="object" string="Post retained earnings close" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <group col="2" class="tcsi-form-sections">
                        <group string="Close details" class="tcsi-form-section">
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="date_end"/>
                            <field name="journal_id"/>
                            <field name="retained_earnings_account_id"/>
                        </group>
                        <group string="Posting summary" class="tcsi-form-section">
                            <field name="profit_loss" readonly="1"/>
                            <field name="line_count" readonly="1"/>
                            <field name="move_id" readonly="1"/>
                        </group>
                        <group string="Notes" class="tcsi-form-section tcsi-form-section-wide">
                            <field name="notes"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_thirdcode_year_end_close" model="ir.actions.act_window">
        <field name="name">Year-end retained earnings</field>
        <field name="res_model">thirdcode.year.end.close</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
