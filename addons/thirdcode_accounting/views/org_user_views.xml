<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_thirdcode_employee_list" model="ir.actions.act_window">
        <field name="name">Employee Accounts</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list</field>
        <field name="domain">[('share', '=', False)]</field>
        <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
    </record>

    <record id="action_thirdcode_employee_wizard" model="ir.actions.act_window">
        <field name="name">New Employee Account</field>
        <field name="res_model">thirdcode.employee.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_thirdcode_password_reset" model="ir.actions.act_window">
        <field name="name">Reset Password</field>
        <field name="res_model">thirdcode.employee.password.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_thirdcode_employee_list" model="ir.ui.view">
        <field name="name">thirdcode.employee.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Employee accounts" create="false" edit="false" delete="false">
                <field name="name"/>
                <field name="login"/>
                <field name="active"/>
                <field name="company_id" groups="base.group_system"/>
                <button name="action_thirdcode_toggle_active" type="object" string="Enable/Disable" class="btn-link"/>
                <button name="%(action_thirdcode_password_reset)d" type="action" string="Reset Password" class="btn-link" context="{'default_user_id': id}"/>
            </list>
        </field>
    </record>

    <record id="view_thirdcode_employee_wizard_form" model="ir.ui.view">
        <field name="name">thirdcode.employee.wizard.form</field>
        <field name="model">thirdcode.employee.wizard</field>
        <field name="arch" type="xml">
            <form string="New Employee Account">
                <sheet>
                    <div class="tcsi-form-sections">
                        <group string="Employee details" class="tcsi-form-section">
                            <field name="name" string="Full name" placeholder="e.g. Maria Santos"/>
                            <field name="login" string="Login email" placeholder="e.g. maria@company.ph"/>
                        </group>
                        <group string="Account access" class="tcsi-form-section">
                            <field name="role" widget="radio"/>
                            <field name="company_id" groups="base.group_system" options="{'no_create': True, 'no_open': True}"/>
                            <field name="password" password="True"/>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_create_employee" type="object" string="Create Account" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_thirdcode_password_wizard_form" model="ir.ui.view">
        <field name="name">thirdcode.employee.password.wizard.form</field>
        <field name="model">thirdcode.employee.password.wizard</field>
        <field name="arch" type="xml">
            <form string="Reset Password">
                <sheet>
                    <div class="tcsi-form-sections">
                        <group string="Account credentials" class="tcsi-form-section tcsi-form-section-wide">
                            <field name="user_id" string="Employee" readonly="1" options="{'no_open': True}"/>
                            <field name="new_password" string="New password" password="True"/>
                        </group>
                    </div>
                </sheet>
                <footer>
                    <button name="action_reset_password" type="object" string="Set Password" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_thirdcode_organization" name="Organization" parent="menu_thirdcode_accounting_root" sequence="15" groups="thirdcode_accounting.group_thirdcode_administrator,base.group_system">
        <menuitem id="menu_thirdcode_employee_accounts" name="Employee Accounts" action="action_thirdcode_employee_list" sequence="10"/>
        <menuitem id="menu_thirdcode_new_employee" name="New Employee Account" action="action_thirdcode_employee_wizard" sequence="20"/>
    </menuitem>
</odoo>
