<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thirdcode_payment_batch_tree" model="ir.ui.view"><field name="name">thirdcode.payment.batch.tree</field><field name="model">thirdcode.payment.batch</field><field name="arch" type="xml"><list string="Payment batches"><field name="name"/><field name="date"/><field name="journal_id"/><field name="partner_type"/><field name="total_amount"/><field name="state" widget="badge"/><field name="requires_approval"/></list></field></record>
    <record id="view_thirdcode_payment_batch_form" model="ir.ui.view">
        <field name="name">thirdcode.payment.batch.form</field><field name="model">thirdcode.payment.batch</field>
        <field name="arch" type="xml">
            <form string="Payment batch">
                <header><button name="action_submit" type="object" string="Submit" class="oe_highlight" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" class="oe_highlight" invisible="state != 'pending_approval'" groups="thirdcode_accounting.group_thirdcode_administrator"/><button name="action_post" type="object" string="Post batch" class="oe_highlight" invisible="state not in ('draft', 'approved')" groups="thirdcode_accounting.group_thirdcode_accountant,thirdcode_accounting.group_thirdcode_administrator"/><button name="action_cancel" type="object" string="Cancel" invisible="state in ('posted', 'cancelled')"/><field name="state" widget="statusbar" statusbar_visible="draft,pending_approval,approved,posted"/></header>
                <sheet>
                    <group col="2" class="tcsi-form-sections">
                        <group string="Payment details" class="tcsi-form-section">
                            <field name="name" readonly="1"/>
                            <field name="company_id"/>
                            <field name="journal_id"/>
                            <field name="date"/>
                            <field name="payment_type"/>
                            <field name="partner_type"/>
                            <field name="payment_instrument"/>
                            <field name="instrument_reference"/>
                        </group>
                        <group string="Approval" class="tcsi-form-section">
                            <field name="total_amount" readonly="1"/>
                            <field name="requires_approval" readonly="1"/>
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="line_ids"><list editable="bottom"><field name="move_id"/><field name="partner_id"/><field name="amount"/><field name="communication"/><field name="payment_instrument"/><field name="instrument_reference"/><field name="payment_id" readonly="1"/></list></field>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_thirdcode_payment_batch" model="ir.actions.act_window"><field name="name">Payment batches</field><field name="res_model">thirdcode.payment.batch</field><field name="view_mode">list,form</field></record>
</odoo>
