<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_thirdcode_report_sample_list" model="ir.ui.view">
        <field name="name">thirdcode.report.sample.list</field>
        <field name="model">thirdcode.report.sample</field>
        <field name="arch" type="xml">
            <list string="Client report samples">
                <field name="name"/>
                <field name="sample_type"/>
                <field name="revision"/>
                <field name="source_filename"/>
                <field name="state" widget="badge"/>
                <field name="approved_by"/>
                <field name="approved_at"/>
            </list>
        </field>
    </record>
    <record id="view_thirdcode_report_sample_form" model="ir.ui.view">
        <field name="name">thirdcode.report.sample.form</field>
        <field name="model">thirdcode.report.sample</field>
        <field name="arch" type="xml">
            <form string="Client report sample">
                <header>
                    <button name="action_approve" type="object" string="Approve sample" class="oe_highlight" groups="thirdcode_accounting.group_thirdcode_administrator" invisible="state == 'approved'"/>
                    <button name="action_reject" type="object" string="Reject sample" groups="thirdcode_accounting.group_thirdcode_administrator" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <group col="2" class="tcsi-form-sections">
                        <group string="Sample details" class="tcsi-form-section">
                            <field name="name"/>
                            <field name="company_id"/>
                            <field name="sample_type"/>
                            <field name="revision"/>
                            <field name="source_filename"/>
                            <field name="source_file" filename="source_filename"/>
                        </group>
                        <group string="Approval" class="tcsi-form-section">
                            <field name="approved_by" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <chatter/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_thirdcode_report_sample" model="ir.actions.act_window">
        <field name="name">Client report samples</field>
        <field name="res_model">thirdcode.report.sample</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
