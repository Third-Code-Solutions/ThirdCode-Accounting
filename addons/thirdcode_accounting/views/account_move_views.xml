<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_thirdcode" model="ir.ui.view">
        <field name="name">account.move.form.thirdcode.accounting</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Encoders can prepare draft journal entries without receiving
                 the broader native accounting-readonly capability. -->
            <xpath expr="//label[@for='journal_id']" position="attributes">
                <attribute name="groups" add="thirdcode_accounting.group_thirdcode_encoder" separator=","/>
            </xpath>
            <xpath expr="//div[@name='journal_div']" position="attributes">
                <attribute name="groups" add="thirdcode_accounting.group_thirdcode_encoder" separator=","/>
            </xpath>
            <xpath expr="//div[@name='journal_div']/field[@name='journal_id']" position="attributes">
                <attribute name="groups" add="thirdcode_accounting.group_thirdcode_encoder" separator=","/>
            </xpath>
            <xpath expr="//page[@name='aml_tab']" position="attributes">
                <attribute name="groups" add="thirdcode_accounting.group_thirdcode_encoder" separator=","/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_print_thirdcode_invoice" type="object" string="Third Code invoice" class="btn-secondary" invisible="state != 'posted' or move_type == 'entry'" groups="account.group_account_invoice,!thirdcode_accounting.group_thirdcode_encoder,!thirdcode_accounting.group_thirdcode_readonly"/>
            </xpath>
            <xpath expr="//button[@name='button_draft']" position="attributes">
                <attribute name="invisible" add="posted_before or state == 'posted'" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='button_cancel'])[1]" position="attributes">
                <attribute name="invisible" add="posted_before or state == 'posted'" separator=" or "/>
            </xpath>
            <xpath expr="(//button[@name='button_cancel'])[2]" position="attributes">
                <attribute name="invisible" add="posted_before or state == 'posted'" separator=" or "/>
            </xpath>
            <!-- Server-side parity: a role that cannot execute an action must
                 not see its button. Confirm/Post, Credit Note, Send and the
                 official document are refused by the server for data-entry
                 and read-only roles; the automatic-post fields are refused
                 for Encoders. -->
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="groups">account.group_account_invoice,!thirdcode_accounting.group_thirdcode_encoder</attribute>
            </xpath>
            <xpath expr="//button[@name='action_reverse']" position="attributes">
                <attribute name="groups">account.group_account_invoice,!thirdcode_accounting.group_thirdcode_encoder</attribute>
            </xpath>
            <xpath expr="//button[@name='action_invoice_sent']" position="attributes">
                <attribute name="groups">account.group_account_invoice,!thirdcode_accounting.group_thirdcode_encoder,!thirdcode_accounting.group_thirdcode_readonly</attribute>
            </xpath>
            <xpath expr="//field[@name='auto_post']" position="attributes">
                <attribute name="groups">!thirdcode_accounting.group_thirdcode_encoder</attribute>
            </xpath>
            <xpath expr="//field[@name='auto_post_until']" position="attributes">
                <attribute name="groups">!thirdcode_accounting.group_thirdcode_encoder</attribute>
            </xpath>
            <xpath expr="//field[@name='checked']" position="attributes">
                <attribute name="groups">!thirdcode_accounting.group_thirdcode_encoder</attribute>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="thirdcode_document_class" string="Document type" readonly="1"/>
            </xpath>
            <xpath expr="//sheet/notebook" position="inside">
                <page name="thirdcode_document_details" string="Document details" class="tcsi-record-metadata">
                    <div class="tcsi-form-sections">
                        <group string="Document reference" class="tcsi-form-section">
                            <field name="thirdcode_source_identifier" string="Source identifier" readonly="state == 'posted'"/>
                            <field name="thirdcode_is_opening_balance" string="Opening balance" readonly="state == 'posted'"/>
                        </group>
                        <group string="Automation" class="tcsi-form-section">
                            <field name="thirdcode_recurring_journal_id" string="Schedule" readonly="1"/>
                            <field name="thirdcode_recurring_run_date" string="Run date" readonly="1"/>
                        </group>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
