<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_thirdcode" model="ir.ui.view">
        <field name="name">account.move.form.thirdcode.accounting</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_print_thirdcode_invoice" type="object" string="Third Code invoice" class="btn-secondary" invisible="state != 'posted' or move_type == 'entry'" groups="account.group_account_invoice"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="thirdcode_document_class" readonly="1"/>
                <field name="thirdcode_source_identifier" readonly="state == 'posted'"/>
                <field name="thirdcode_is_opening_balance" readonly="state == 'posted'"/>
                <field name="thirdcode_recurring_journal_id" readonly="1"/>
                <field name="thirdcode_recurring_run_date" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
