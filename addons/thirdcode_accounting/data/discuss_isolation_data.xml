<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_company_discuss_channel" model="ir.rule">
        <field name="name">Discuss: organization boundary, including platform staff</field>
        <field name="model_id" ref="mail.model_discuss_channel"/>
        <field name="global" eval="True"/>
        <field name="domain_force">user._thirdcode_discuss_domain(company_ids)</field>
    </record>
    <record id="rule_company_discuss_member" model="ir.rule">
        <field name="name">Discuss members: organization boundary</field>
        <field name="model_id" ref="mail.model_discuss_channel_member"/>
        <field name="global" eval="True"/>
        <field name="domain_force">user._thirdcode_discuss_domain(company_ids, 'channel_id.')</field>
    </record>
    <record id="rule_company_discuss_rtc" model="ir.rule">
        <field name="name">Discuss calls: organization boundary</field>
        <field name="model_id" ref="mail.model_discuss_channel_rtc_session"/>
        <field name="global" eval="True"/>
        <field name="domain_force">user._thirdcode_discuss_domain(company_ids, 'channel_id.')</field>
    </record>
    <record id="rule_company_discuss_message" model="ir.rule">
        <field name="name">Discuss messages: organization boundary</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('model', '!=', 'discuss.channel'), '&amp;'] + user._thirdcode_discuss_domain(company_ids, 'thirdcode_channel_id.')</field>
    </record>
    <record id="rule_company_discuss_attachment" model="ir.rule">
        <field name="name">Discuss attachments: organization boundary</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('res_model', '!=', 'discuss.channel'), '&amp;'] + user._thirdcode_discuss_domain(company_ids, 'thirdcode_channel_id.')</field>
    </record>
    <function model="discuss.channel" name="_install_company_discuss"/>
</odoo>
