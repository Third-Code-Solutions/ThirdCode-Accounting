<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="base.main_company" model="res.company">
            <field name="name">Third Code Solutions Inc.</field>
            <field name="logo" type="base64" file="thirdcode_accounting/static/src/img/tcsi-logo.svg"/>
        </record>
    </data>
    <function model="ir.config_parameter" name="set_param">
        <value eval="'web.web_app_name'"/>
        <value eval="'TCSI Accounting'"/>
    </function>
    <record id="base.partner_root" model="res.partner">
        <field name="name">TCSI Workspace Assistant</field>
        <field name="image_1920" type="base64" file="thirdcode_accounting/static/src/img/orvexa-avatar.png"/>
    </record>
</odoo>
